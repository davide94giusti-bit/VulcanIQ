{
  "name": "vulcaniq-landing-page",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:security": "node tools/security-regression.mjs",
    "test:analytics": "node tools/analytics-regression.mjs",
    "test:seo": "node tools/seo-regression.mjs",
    "test:reviews": "node tools/reviews-regression.mjs",
    "test:media": "node tools/media-optimizer-regression.mjs",
    "test:quality": "npm run test:security && npm run test:analytics && npm run test:seo && npm run test:reviews && npm run test:media && npm run test:finance && npm run test:homepage && npm run test:notifications && npm run test:participants && npm run test:backup && npm run test:neo && npm run build",
    "test:finance": "node tools/finance-regression.mjs",
    "test:homepage": "node tools/homepage-cms-regression.mjs",
    "test:notifications": "node tools/web-push-regression.mjs && node tools/notifications-regression.mjs",
    "test:participants": "node tools/participants-onboarding-regression.mjs",
    "test:web-push": "node tools/web-push-regression.mjs",
    "test:backup": "node tools/backup-regression.mjs",
    "test:neo": "node tools/neo-regression.mjs",
    "test:supabase-migrations": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/supabase-migration-reproducibility.ps1"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@supabase/supabase-js": "2.48.1",
    "jose": "5.9.6"
  },
  "devDependencies": {
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18 <23"
  }
}
